# Local JSON storage (recommended for local development)
WORKSPACE_STORE_PROVIDER=local

# To test Vercel Blob locally, change the provider and set a token:
# WORKSPACE_STORE_PROVIDER=vercel-blob
# BLOB_READ_WRITE_TOKEN=

# 部内ページ(ログイン・名簿)
# DATABASE_URL を書かなければ、ローカルでは .data/portal-db に保存する(PGlite)。
# DATABASE_URL=postgres://...
# 合言葉を変えると、全員がログインし直しになる。
# PORTAL_PASSPHRASE=
# クッキーの署名に使う。`openssl rand -base64 32` で作る。
# PORTAL_SESSION_SECRET=
# ログインまわりの知らせを送る Slack の Incoming Webhook(なくても動く)
# PORTAL_ALERT_SLACK_WEBHOOK_URL=
# 部員に DM を送る Slack アプリのトークン(コメント・「リーダーへ」の知らせ。なくても動く)
# SLACK_BOT_TOKEN=xoxb-...
# 遅刻・欠席の連絡を流す Slack のチャンネルの ID(C で始まる。ボットをチャンネルに招待しておく)
# SLACK_ATTENDANCE_CHANNEL=C0123ABCD
